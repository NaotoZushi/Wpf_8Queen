<Window x:Class="Wpf_8Queen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="8クイーン問題" Height="620" Width="620"
        MinHeight="560" MinWidth="560">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="8クイーン問題" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" Text="解くボタンで解を表示します。"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" HorizontalAlignment="Center">
            <UniformGrid x:Name="Board" Rows="8" Columns="8" Width="480" Height="480"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="解く" Width="100" Margin="4" Padding="8" Click="SolveButton_Click"/>
            <Button Content="次の解" Width="100" Margin="4" Padding="8" Click="NextButton_Click"/>
            <Button Content="リセット" Width="100" Margin="4" Padding="8" Click="ResetButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
